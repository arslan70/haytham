{
  "$defs": {
    "AcceptanceCriterion": {
      "description": "A single acceptance criterion in structured Gherkin format.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "given": {
          "default": "",
          "title": "Given",
          "type": "string"
        },
        "when": {
          "default": "",
          "title": "When",
          "type": "string"
        },
        "then": {
          "default": "",
          "title": "Then",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scenario"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "ContractMetadata": {
      "description": "Top-level metadata about the contract generation context.",
      "properties": {
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "idea_summary": {
          "title": "Idea Summary",
          "type": "string"
        },
        "appetite": {
          "default": "",
          "title": "Appetite",
          "type": "string"
        }
      },
      "required": [
        "generated_at",
        "idea_summary"
      ],
      "title": "ContractMetadata",
      "type": "object"
    },
    "ContractStory": {
      "description": "A single story with structured traceability fields.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "layer": {
          "title": "Layer",
          "type": "integer"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "implements": {
          "items": {
            "type": "string"
          },
          "title": "Implements",
          "type": "array"
        },
        "uses": {
          "items": {
            "type": "string"
          },
          "title": "Uses",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "layer",
        "summary"
      ],
      "title": "ContractStory",
      "type": "object"
    }
  },
  "description": "Top-level execution contract for downstream consumers.\n\nBuilt deterministically from StoryHybrid output + session state.\nThe LLM never produces this directly (ADR-025 complexity constraint).",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ContractMetadata"
    },
    "system_traits": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "title": "System Traits",
      "type": "object"
    },
    "stories": {
      "items": {
        "$ref": "#/$defs/ContractStory"
      },
      "title": "Stories",
      "type": "array"
    }
  },
  "required": [
    "metadata"
  ],
  "title": "ExecutionContract",
  "type": "object"
}
